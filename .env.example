# ==========================================
# KADO — Variables d'environnement
# ==========================================
# Copie ce fichier en .env.local et remplis les valeurs
# NE JAMAIS commiter le .env.local !
# Sur Vercel : Settings → Environment Variables
# ==========================================

# Site URL (Vercel le met automatiquement, sinon ton domaine)
NEXT_PUBLIC_SITE_URL=https://kado-box.fr

# Google Analytics (optionnel pour commencer)
NEXT_PUBLIC_GA_ID=

# Awin API (pour récupérer les promos automatiquement)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Affilae API (Dashboard → API Tokens)
# Un seul token Bearer suffit
AFFILAE_API_KEY=

# Kwanko API (Publisher dashboard → API management)
KWANKO_API_KEY=

# Amazon Creators API (remplace PA-API 5.0 depuis 2026)
# Credentials dans Associates Central → Outils → Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=

# GitHub token (pour persister les données via API)
GITHUB_TOKEN=
